# The default Node.js app needs no environment file, account or database.
# Optional production process settings:
# HOST=0.0.0.0
# PORT=3000
#
# Optional research backend only (see deploy/cloudflare/README.md):
# ADMIN_USER_ID=your-owner-id
# ADMIN_BOOTSTRAP_EMAIL=your-owner-email
# AUTH_PROXY_SECRET=generate-a-random-secret-with-at-least-32-characters
# AUTH_SIGN_IN_PATH=/login
# AUTH_SIGN_OUT_PATH=/logout
